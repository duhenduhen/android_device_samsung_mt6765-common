type samsung_hal_keymaster_service, domain;
type samsung_hal_keymaster_service_exec, exec_type, vendor_file_type, file_type;

init_daemon_domain(samsung_hal_keymaster_service)

hal_server_domain(samsung_hal_keymaster_service, hal_keymaster)

get_prop(samsung_hal_keymaster_service, vendor_tzts_prop)

allow samsung_hal_keymaster_service tz_device:chr_file rw_file_perms;

allow samsung_hal_keymaster_service grdm_device:chr_file rw_file_perms;

allow samsung_hal_keymaster_service efs_file:dir search;

allow samsung_hal_keymaster_service mnt_vendor_file:dir search;
